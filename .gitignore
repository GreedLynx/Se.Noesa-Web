# Dependensi / Pustaka Aplikasi
/node_modules
/vendor
npm-debug.log*
yarn-debug.log*

# File Lingkungan & Kredensial Rahasia (Sangat Penting)
.env
.env.local
.env.production

# Uploads Lokal (Agar foto dummy saat testing tidak mengotori Git)
/public/uploads/*
!/public/uploads/.gitkeep
# Aturan deny untuk bukti lama harus tetap ikut version control
!/public/uploads/payments/
/public/uploads/payments/*
!/public/uploads/payments/.htaccess
!/public/uploads/payments/web.config
# Bukti pembayaran baru disimpan di luar public dan tidak boleh masuk Git
/storage/payments/*
!/storage/payments/.gitkeep
.opencode/docs/
.opencode/*
.codex/*
.repomixignore
repomix-output.xml
repomix.config.json
docs/00-panduan/HANDOFF.md

# System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
!/public/uploads/products/
!/public/uploads/products/.gitkeep
