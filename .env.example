# Konfigurasi Aplikasi
APP_NAME="Se.Noesa Web"
APP_ENV=local
APP_URL=http://localhost:3000

# Konfigurasi Basis Data PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=senoesa
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Gmail SMTP (development); set SMTP_HOST=smtp-relay.brevo.com for Brevo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Se.Noesa Catering"
